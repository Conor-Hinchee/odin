#!/bin/sh
# Fake gh for eval sandboxes: records each call with the branch it ran on, fakes PR creation.
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
echo "$(date -u +%FT%TZ) [branch=$BRANCH] gh $*" >> "${ODIN_EVAL_GH_LOG:-/dev/null}"
case "$1 $2" in
  "pr create") echo "https://github.example/eval/sandbox/pull/1" ;;
  "pr view") echo '{"url":"https://github.example/eval/sandbox/pull/1","state":"OPEN"}' ;;
  *) echo "" ;;
esac
exit 0
