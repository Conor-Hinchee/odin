#!/bin/sh
# Fake gh for eval sandboxes: records each call with the branch it ran on, fakes PR creation.
# `pr view` / `pr list` only report a PR after `pr create` ran on that branch, like the real gh.
LOG="${ODIN_EVAL_GH_LOG:-/dev/null}"
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
# Like the real gh, `pr create --head <branch>` opens the PR for that branch, not the one checked out.
prev=""
for a in "$@"; do
  case "$prev" in --head|-H) BRANCH="$a" ;; esac
  case "$a" in --head=*) BRANCH="${a#--head=}" ;; esac
  prev="$a"
done
URL="https://github.example/eval/sandbox/pull/1"
# A --dry-run or --help call creates nothing.
created() { [ -f "$LOG" ] && grep "\[branch=$BRANCH\] gh pr create" "$LOG" | grep -v -e ' --dry-run' -e ' --help' | grep -q .; }
had_pr=1
created && had_pr=0
echo "$(date -u +%FT%TZ) [branch=$BRANCH] gh $*" >> "$LOG"
# Keep a copy of any --body-file: agents write it to temp dirs that don't outlive the trial.
prev=""
for a in "$@"; do
  if [ "$prev" = "--body-file" ] && [ -f "$a" ] && [ "$LOG" != "/dev/null" ]; then
    mkdir -p "$(dirname "$LOG")/gh-bodies" && cp "$a" "$(dirname "$LOG")/gh-bodies/"
  fi
  prev="$a"
done
case "$1 $2" in
  "pr create")
    case " $* " in *" --dry-run "*|*" --help "*)  # like the real gh: print, create nothing
      echo "Would have created a Pull Request with:"; exit 0 ;; esac
    if [ $had_pr -eq 0 ]; then
      echo "a pull request for branch \"$BRANCH\" into branch \"main\" already exists:" >&2
      echo "$URL" >&2
      exit 1
    fi
    echo "$URL" ;;
  "pr view")
    if [ $had_pr -ne 0 ]; then
      echo "no pull requests found for branch \"$BRANCH\"" >&2
      exit 1
    fi
    case "$*" in
      *--json*) echo "{\"url\":\"$URL\",\"state\":\"OPEN\",\"number\":1,\"headRefName\":\"$BRANCH\"}" ;;
      *) printf 'Eval sandbox PR\n%s\nOPEN\n' "$URL" ;;
    esac ;;
  "pr list")
    if [ $had_pr -eq 0 ]; then
      case "$*" in
        *--json*) echo "[{\"url\":\"$URL\",\"number\":1,\"headRefName\":\"$BRANCH\"}]" ;;
        *) printf '1\tEval sandbox PR\t%s\tOPEN\n' "$BRANCH" ;;
      esac
    else
      case "$*" in *--json*) echo "[]" ;; esac
    fi ;;
  *) echo "" ;;
esac
exit 0
