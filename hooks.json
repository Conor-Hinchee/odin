{
  "odin": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./skills/odin/scripts/odin-session-start.py"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./skills/odin/scripts/odin-pr-hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./skills/odin/scripts/odin-progress-hook.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
